# Modèle de configuration de l'orchestrateur.
#
#   cp .env.example .env
#
# Contrairement à `mass-mcp`, ce service détient un secret : `SECRET`, celui qui
# signe les jetons de `mass-backend`. Il en a besoin pour *vérifier* les jetons
# qu'on lui présente — il n'en émet aucun. C'est le prix de la façade : elle est
# la seule frontière d'authentification, donc c'est elle qui tranche.

# --- Écoute HTTP --------------------------------------------------------------
PORT=4100
HOST=0.0.0.0

# Origines autorisées, séparées par des virgules. La liste par défaut est celle
# de `mass-backend/src/index.ts`, qui est en dur : les deux doivent rester
# alignées, sinon le back-office joint l'API mais pas l'agent.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5176,http://192.168.88.20,http://92.222.79.80:5173

# --- Authentification ---------------------------------------------------------
# Le même secret que `mass-backend`, au caractère près. Un secret différent fait
# échouer toutes les vérifications avec « jeton invalide », ce qui se lirait
# comme un problème de session côté utilisateur.
SECRET=

# --- Serveur MCP --------------------------------------------------------------
MCP_URL=http://localhost:4000/mcp
MCP_TIMEOUT_S=30

# --- Base de données ----------------------------------------------------------
# La base de MASS. Deux usages, séparés : la relecture du rôle administrateur
# (schéma `public`, en lecture) et les checkpoints de conversation (schéma
# dédié, en écriture).
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=mass_db_seed_test

# Schéma réservé à ce service. Il doit rester hors de portée des migrations
# TypeORM de `mass-backend`, qui ne connaissent que `public`.
CHECKPOINT_SCHEMA=agents

# --- Modèle -------------------------------------------------------------------
# anthropic | openai. Seule la clé du fournisseur choisi est exigée.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Vide : le modèle par défaut du fournisseur (voir `DEFAULT_MODELS`).
MODEL=
MODEL_MAX_TOKENS=8192
# low | medium | high. À mesurer sur des demandes réelles avant de baisser.
AGENT_EFFORT=high

# --- Plafonds -----------------------------------------------------------------
# Un graphe qui boucle coûte de l'argent à chaque tour : les trois plafonds
# ci-dessous sont des garde-fous durs, pas des réglages de confort. Ils valent
# par demande de l'utilisateur ; une validation humaine ne les remet pas à zéro.
MAX_STEPS=15
MAX_TOKENS_PER_REQUEST=400000
RUN_TIMEOUT_S=300
